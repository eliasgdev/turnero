{
  "name": "turnero",
  "version": "0.1.0",
  "description": "Cola de trabajos para Node.js sobre PostgreSQL: sin Redis, con reintentos y encolado dentro de tus transacciones",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "podman compose up -d || docker compose up -d"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "queue",
    "job-queue",
    "jobs",
    "worker",
    "skip-locked",
    "background-jobs"
  ],
  "author": "Elias Gutiérrez <gutimiguel2007@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasgdev/turnero.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  }
}
